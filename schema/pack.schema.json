{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabtrainer.app/schema/pack.schema.json",
  "title": "Tab Trainer Content Pack",
  "description": "A versioned bundle of practice entries (drills, scales, riffs, songs). String index 0 = high e ... 5 = low E.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "license", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "license": { "$ref": "#/$defs/license" },
    "attribution": { "type": "string" },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "usd": { "type": "number", "minimum": 0 } }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "license": {
      "enum": [
        "public-domain",
        "cc-by-4.0",
        "cc-by-sa-4.0",
        "original",
        "proprietary",
        "user-content"
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["string", "fret"],
      "properties": {
        "string": { "type": "integer", "minimum": 0, "maximum": 5, "description": "0 = high e ... 5 = low E" },
        "fret": { "type": "integer", "minimum": 0, "maximum": 24 },
        "beat": { "type": "number", "minimum": 0, "description": "Optional. Used when mode = timed." },
        "duration": { "type": "number", "exclusiveMinimum": 0, "description": "Optional. In beats when mode = timed." }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "difficulty", "mode"],
      "anyOf": [
        { "required": ["notes"] },
        { "required": ["frets"] }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["drill", "scale", "riff", "song", "ear", "rhythm", "chord"] },
        "category": { "enum": ["fretboard", "scale", "technique", "ear", "rhythm", "chord", "song", "theory"] },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "tuning": {
          "description": "Either \"standard\" or an explicit array of 6 note names from high e to low E.",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "string" } }
          ]
        },
        "capo": { "type": "integer", "minimum": 0, "maximum": 12 },
        "tempo": { "type": "integer", "minimum": 20, "maximum": 400 },
        "timeSignature": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "mode": { "enum": ["sequence", "timed"], "description": "sequence = play in order (drill); timed = beat-aligned (song)." },
        "notes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/note" } },
        "frets": {
          "description": "Shorthand for sequence drills: array of [string, fret] pairs.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "type": "integer", "minimum": 0, "maximum": 5 },
              { "type": "integer", "minimum": 0, "maximum": 24 }
            ]
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["hand", "ascii", "guitarpro", "musicxml", "midi"] },
            "ref": { "type": "string" }
          }
        },
        "attribution": { "type": "string" },
        "license": { "$ref": "#/$defs/license" }
      }
    }
  }
}
